# Log decisions without moving mail (true/false, 1/0).
DRY_RUN=true

# URL-encode special characters in username/password (@ => %40, : => %3A, / => %2F).
IMAP_DSN=imaps://user%40example.org:password@imap.example.org:993

# Folders must already exist on the server and must all differ.
# Names can be written normally, including umlauts (e.g. Amazon/geschäftlich).
SOURCE_FOLDER=INBOX
# Spam goes here.
TARGET_FOLDER=Junk
# Clean mail goes here, unless a rule in config/mapping.json picks another folder. Required.
CLEAN_FOLDER=Checked
# Mail the sorter is not sure about. Required when unsure_threshold or SPAM_UNSURE_SCORE is set.
UNSURE_FOLDER=Review

# Spam score at or above which mail is spam.
SPAM_SCORE=5
# Optional: spam scores from this value up to SPAM_SCORE go to UNSURE_FOLDER (1 to SPAM_SCORE-1).
# SPAM_UNSURE_SCORE=3

# Seconds between runs (minimum 30).
POLL_SECONDS=300
# Maximum messages per run, oldest first; messages that stayed in the source folder are retried later.
MAX_PER_RUN=100

# Apply the whitelist and "from" rule conditions only when Authentication-Results reports dmarc=pass.
REQUIRE_DMARC_FOR_LISTS=true

# Recommended: name your mail server writes at the start of its Authentication-Results header,
# e.g. "Authentication-Results: mail.example.org; dkim=pass ..." -> mail.example.org.
# Only that server's topmost header is then trusted; headers forged by a sender are ignored.
# If unset, all headers are trusted and a warning is logged at startup.
# AUTHSERV_ID=mail.example.org

# Optional: host directory with mapping.json, whitelist.json and blacklist.json (default ./config).
# Read by Docker Compose; set it when several mailboxes run from the same project directory.
# CONFIG_DIR=./config

# Optional: config file paths inside the container (defaults shown).
# MAPPING_FILE=/config/mapping.json
# WHITELIST_FILE=/config/whitelist.json
# BLACKLIST_FILE=/config/blacklist.json
